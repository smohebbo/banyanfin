## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio cache/options directory
.vs/

# Build Results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2022 cache directory
.vs/

# Visual Studio Code
.vscode/

# Rider
.idea/
*.sln.iml

# Build output
**/bin/
**/obj/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# NuGet cache
.nuget/

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx

# Code coverage
coverage/
coverage*.xml

# ASP.NET Core publish output
publish/
**/publish/

# Generated files
Generated/
*.generated.cs

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# Database files
*.db
*.sqlite
*.sqlite3
*.mdf
*.ldf

# Local configuration / secrets
.env
.env.*
!.env.example

# ASP.NET Core local settings
appsettings.Local.json

# User secrets
secrets.json
