@model Banyan.Entities.viewModel.ClientIndexViewModel

@{
    ViewData["Title"] = "Clients";
}

<form asp-controller="Client" asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-12 col-md-8 col-lg-6">
        <input id="searchTerm"
               name="searchTerm"
               type="search"
               value="@Model.SearchTerm"
               class="form-control"
               maxlength="100"
               placeholder="Name, member number, mobile, email or client ID"
               autocomplete="off" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
    @if (!string.IsNullOrEmpty(Model.SearchTerm))
    {
        <div class="col-auto">
            <a asp-controller="Client" asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        </div>
    }
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <caption class="visually-hidden">Client directory search results</caption>
        <thead class="table-light">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Member</th>
                <th scope="col">Name</th>
                @* <th scope="col">Bangla</th> *@
                <th scope="col">Mobile</th>
                <th scope="col">Email</th>
                <th scope="col">Type</th>
                <th scope="col">Subscription</th>
                <th scope="col">Status</th>
                <th scope="col">Verified</th>
                @* <th scope="col">issued(ID)</th> *@
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Clients.Count == 0)
            {
                <tr>
                    <td colspan="12" class="text-center py-5">
                        <p class="fw-semibold mb-1">No clients found</p>
                        <p class="text-muted mb-0">Try a different search term or clear the filter.</p>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var client in Model.Clients)
                {
                    <tr>
                        <td>@client.ID</td>
                        <td>@(client.MemberNo?.ToString() ?? "—")</td>
                        <td>
                            @if (client.IsInstitute == true)
                            {
                                @client.ClientName
                            }
                            else
                            {
                                @client.ClientName
                                @if (!string.IsNullOrWhiteSpace(client.ClientLastName))
                                {
                                    <text> @client.ClientLastName</text>
                                }
                            }
                        </td>
                        @* <td>@(client.ClientNameBangla ?? "—")</td> *@
                        <td>@(client.MobileNo ?? "—")</td>
                        <td>@(client.EmailID ?? "—")</td>
                        <td>@(client.IsInstitute == true ? "Institution" : "Individual")</td>
                        <td>@(client.SubscriptionTypeID?.ToString() ?? "—")</td>
                        <td>@(client.ClientStatusID?.ToString() ?? "—")</td>
                        <td>
                            @if (client.IsVerified)
                            {
                                <span class="badge text-bg-success">Verified</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Not verified</span>
                            }
                        </td>
                        @* <td>@(client.IDIssueDate?.ToString("dd MMM yyyy") ?? "—")</td> *@
                        <td>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Actions for client @client.ID">
                                    Actions
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item disabled" aria-disabled="true">Edit</span></li>
                                    <li><span class="dropdown-item disabled" aria-disabled="true">Details</span></li>
                                    <li><span class="dropdown-item disabled" aria-disabled="true">Address</span></li>
                                    <li><span class="dropdown-item disabled" aria-disabled="true">AddAddress</span></li>
                                    <li><span class="dropdown-item disabled" aria-disabled="true">Deactivate</span></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<p class="small text-muted mt-3">
    Client management actions are disabled because corresponding client and address endpoints are not present in this application.
</p>
