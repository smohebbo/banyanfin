<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Banyan</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/banyan.css" />
    @* <link rel="stylesheet" href="~/Banyan.styles.css" asp-append-version="true" /> *@
</head>
<body class="bg-light">
    <partial name="_header" />
    <div class="container-fluid">
        <div class="row min-vh-100">
            @* Left Navigation *@
            <aside class="col-12 col-md-3 col-lg-2 bg-white border-end p-0">
                <partial name="_leftMenu" />
            </aside>
            @* Main Content *@
            <main role="main" class="col-12 col-md-9 col-lg-10 p-4">
                @RenderBody()
            </main>
        </div>
    </div>
    <partial name="_footer" />
    <script src="~/js/banyan.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

