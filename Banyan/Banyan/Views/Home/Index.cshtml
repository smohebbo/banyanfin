@model Banyan.Entities.viewModel.loginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link rel="stylesheet" href="~/css/banyan.css" />
</head>

<body class="bg-light overflow-hidden">
    <div class="container-fluid vh-100 d-flex align-items-center justify-content-center p-3">
        <div class="row w-100 justify-content-center">
            <div class="col-12 col-md-10 col-lg-8 col-xl-7">

                <div class="card shadow border-0">
                    <div class="row g-0">

                        <!-- Left Side -->
                        <div class="col-md-5 bg-primary text-white d-flex align-items-center">
                            <div class="p-4 p-lg-5">

                                <div class="mb-4">
                                    <span class="badge bg-info fs-5 p-3">
                                        A
                                    </span>
                                </div>

                                <h1 class="fw-bold">
                                    Welcome Back
                                </h1>

                                <p class="lead mt-3">
                                    Sign in to access your account and continue managing your
                                    transactions securely.
                                </p>

                                <div class="mt-4">
                                    <span class="badge bg-success">
                                        ✓ Secure &amp; Protected
                                    </span>
                                </div>

                            </div>
                        </div>

                        <!-- Right Side -->
                        <div class="col-md-7">
                            <div class="card-body p-4 p-lg-5">

                                <form asp-controller="Authentication" asp-action="Authenticate" method="post">

                                    @Html.AntiForgeryToken()

                                    <div class="mb-4">
                                        <h2 class="fw-bold text-primary">
                                            Sign In
                                        </h2>

                                        <p class="text-muted mb-0">
                                            Enter your credentials to continue.
                                        </p>
                                    </div>

                                    <!-- Validation Summary -->
                                    <div asp-validation-summary="ModelOnly" class="alert alert-danger">
                                    </div>

                                    <!-- User ID -->
                                    <div class="mb-3">
                                        <label asp-for="UserId" class="form-label fw-semibold">
                                            User ID
                                        </label>

                                        <input asp-for="UserId" class="form-control form-control-lg"
                                               placeholder="Enter your user ID" autocomplete="username" />

                                        <span asp-validation-for="UserId" class="text-danger small">
                                        </span>
                                    </div>

                                    <!-- Password -->
                                    <div class="mb-3">
                                        <label asp-for="Password" class="form-label fw-semibold">
                                            Password
                                        </label>

                                        <div class="input-group">
                                            <input asp-for="Password" type="password" id="password"
                                                   class="form-control form-control-lg" placeholder="Enter your password"
                                                   autocomplete="current-password" />

                                            <button type="button" class="btn btn-outline-secondary" id="togglePassword">
                                                Show
                                            </button>
                                        </div>

                                        <span asp-validation-for="Password" class="text-danger small">
                                        </span>
                                    </div>

                                    <!-- Forgot Password -->
                                    <div class="d-flex justify-content-between align-items-center mb-4">

                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="forgotPassword"
                                                   name="forgotPassword" value="true" />

                                            <label class="form-check-label" for="forgotPassword">
                                                Forgot password
                                            </label>
                                        </div>

                                        <a href="#" class="link-info text-decoration-none">
                                            Reset Password
                                        </a>

                                    </div>

                                    <!-- Submit -->
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary btn-lg">
                                            Sign In
                                        </button>
                                    </div>

                                    <!-- Footer -->
                                    <div class="text-center mt-4">
                                        <small class="text-muted">
                                            © @DateTime.Now.Year Your Company.
                                            All rights reserved.
                                        </small>
                                    </div>

                                </form>

                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>

    <script src="~/js/banyan.js"></script>

    <script>
            document
                .getElementById("togglePassword")
                .addEventListener("click", function () {
                    const password = document.getElementById("password");

                    if (password.type === "password") {
                        password.type = "text";
                        this.textContent = "Hide";
                    } else {
                        password.type = "password";
                        this.textContent = "Show";
                    }
                });
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>

</html>
